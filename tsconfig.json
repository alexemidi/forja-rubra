{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/nucleo/**/*.ts",
    "src/ui/**/*.ts",
    "src/components/**/*.ts",
    "src/lib/**/*.ts",
    "src/interfaces/**/*.ts",
    "src/tipos/**/*.d.ts",
    "testes/unit/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "raiz",
    "backups",
    "Seizis",
    "gerador-ficha-tormenta20-main"
  ]
}
