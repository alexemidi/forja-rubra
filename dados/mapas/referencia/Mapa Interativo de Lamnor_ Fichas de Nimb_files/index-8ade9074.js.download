mbém pasma por 1 rodada (uma criatura só pode ficar pasma por este efeito uma vez por cena). Para cada 10 pontos pelos quais você vencer o teste oposto, a penalidade aumenta em 1 e, se a criatura estava enfeitiçada, fascinada ou pasma, a penalidade aumenta em 1 para cada uma dessas condições. A cada rodada, a penalidade acumulada da criatura diminui em 1. A cada quatro níveis, você pode gastar +1 PM para receber +5 no teste de Diplomacia. A partir do 5º nível, quando usa esta habilidade, você pode gastar +2 PM. Se fizer isso, afeta todas as criaturas à sua escolha em alcance curto. Mental."},DEITY_CLASS_VARIANTS=[{deity:"Marah",className:"Paladino",alternativeAbility:{replaces:"Golpe Divino",ability:MENSAGEM_DE_PAZ},initialSkillSwap:{from:Skill$3.LUTA,to:Skill$3.DIPLOMACIA},addedClassSkills:[Skill$3.ATUACAO,Skill$3.LUTA]}];function findDeityClassVariant(_e,et){if(!et)return;const tt=getClassFamilyName(et),at=_e.map(normalizeDeityName);return DEITY_CLASS_VARIANTS.find(rt=>rt.className===tt&&at.includes(normalizeDeityName(rt.deity)))}function getDeityClassVariant(_e,et,tt){if(tt.includes(SupplementId.TORMENTA20_DEUSES_ARTON))return findDeityClassVariant(_e,et)}function applyDeityClassAbilitySwap(_e,et,tt){const at=et==null?void 0:et.alternativeAbility;if(!at||tt!==at.ability.name)return _e;const rt=_e.findIndex(ot=>ot.name===at.replaces);if(rt===-1)return _e;const nt=cloneDeep$1(at.ability);return[..._e.slice(0,rt),{...nt,sourceClassName:_e[rt].sourceClassName},..._e.slice(rt+1)]}function applyDeityClassVariant(_e,et,tt){if(!et)return _e;const at=applyDeityClassAbilitySwap(_e.abilities,et,tt==null?void 0:tt.alternativeAbility),rt=(et.addedClassSkills||[]).filter(ot=>!_e.periciasrestantes.list.includes(ot)),nt=et.initialSkillSwap&&(tt!=null&&tt.swapInitialSkill)?_e.periciasbasicas.map(ot=>({...ot,list:ot.list.map(st=>st===et.initialSkillSwap.from?et.initialSkillSwap.to:st)})):_e.periciasbasicas;return at===_e.abilities&&rt.length===0&&nt===_e.periciasbasicas?_e:{..._e,