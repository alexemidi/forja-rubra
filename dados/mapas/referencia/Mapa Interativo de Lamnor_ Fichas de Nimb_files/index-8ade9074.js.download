bject.entries(SkillsAttrs).filter(([,tt])=>et.includes(tt)).map(([tt])=>({type:"skill",value:_e,target:tt}))}const CONDITION_TEMPLATES={abalado:{id:"abalado",name:"Abalado",category:"medo",icon:"FlashOn",shortEffect:"−2 em testes de perícia",description:"O personagem sofre −2 em testes de perícia. Se ficar abalado novamente, em vez disso fica apavorado. Medo.",mechanical:!0,generateBonuses:()=>allSkillsPenalty(-2),generateThreatEffects:()=>threatSkillsPenalty(-2)},agarrado:{id:"agarrado",name:"Agarrado",category:"movimento",icon:"PanTool",shortEffect:"Desprevenido, imóvel, −2 em ataques",description:"O personagem fica desprevenido e imóvel, sofre −2 em testes de ataque e só pode atacar com armas leves. Ataques à distância contra um alvo envolvido em uma manobra agarrar têm 50% de chance de acertar o alvo errado. Movimento.",mechanical:!0,implies:["desprevenido","imovel"],generateBonuses:()=>[{target:{type:"AllAttackBonus"},modifier:{type:"Fixed",value:-2}}],generateThreatEffects:()=>[{type:"attackBonus",value:-2}]},alquebrado:{id:"alquebrado",name:"Alquebrado",category:"mental",icon:"AutoFixOff",shortEffect:"Custo de habilidades +1 PM",description:"O custo em pontos de mana das habilidades do personagem aumenta em +1. Mental.",mechanical:!1},apavorado:{id:"apavorado",name:"Apavorado",category:"medo",icon:"Report",shortEffect:"−5 em testes de perícia; foge da fonte do medo",description:"O personagem sofre −5 em testes de perícia e não pode se aproximar voluntariamente da fonte do medo. Medo.",mechanical:!0,generateBonuses:()=>allSkillsPenalty(-5),generateThreatEffects:()=>threatSkillsPenalty(-5)},atordoado:{id:"atordoado",name:"Atordoado",category:"mental",icon:"Bolt",shortEffect:"Desprevenido; não pode agir",description:"O personagem fica desprevenido e não pode fazer ações. Mental.",mechanical:!0,implies:["desprevenido"]},caido:{id:"caido",name:"Caído",category:"movimento",icon:"KeyboardArrowDown",shortEffect:"−5 ataque CaC e Defesa; deslocamento 1,5m",description:"O personagem sofre −5 em ataques corpo a corpo e seu deslocamento é reduzido a 1,5m. Além disso, sofre −5 na Defesa contra ataques corpo a corpo e recebe +5 na Defesa contra ataques à distância (cumulativos com outras condições).",mechanical:!0,generateBonuses:()=>[{target:{type:"Defense"},modifier:{type:"Fixed",value:-5}},{target:{type:"AllAttackBonus"},modifier:{type:"Fixed",value:-5}},{target:{type:"DisplacementOverride"},modifier:{type:"Fixed",value:1.5}}],generateThreatEffects:()=>[{type:"defense",value:-5},{type:"attackBonus",value:-5}]},cego:{id:"cego",name:"Cego",category:"sentidos",icon:"VisibilityOff",shortEffect:"Desprevenido, lento; −5 em perícias FOR/DES",description:"O personagem fica desprevenido e lento, não pode fazer testes de Percepção para observar e sofre −5 em testes de perícias baseadas em Força ou Destreza. Todos os alvos de seus ataques recebem camuflagem total. Você é considerado cego enquanto estiver em uma área de escuridão total, a menos que algo lhe permita perceber no escuro. Sentidos.",mechanical:!0,implies:["desprevenido","lento"],generateBonuses:()=>skillsByAttrsPenalty(-5,[Atributo.FORCA,Atributo.DESTREZA]),generateThreatEffects:()=>threatSkillsByAttrsPenalty(-5,[Atributo.FORCA,Atributo.DESTREZA])},confuso:{id:"confuso",name:"Confuso",category:"mental",icon:"Psychology",shortEffect:"Comportamento aleatório (1d6/turno)",description:"O personagem comporta-se de modo aleatório. Role 1d6 no início de seus turnos: 1) Movimenta-se em uma direção escolhida por uma rolagem de 1d8; 2-3) Não pode fazer ações, e fica balbuciando incoerentemente; 4-5) Usa a arma que estiver empunhando para atacar a criatura mais próxima, ou a si mesmo se estiver sozinho (nesse caso, apenas role o dano); 6) A condição termina e pode agir normalmente. Mental.",mechanical:!1},debilitado:{id:"debilitado",name:"Debilitado",category:"geral",icon:"RemoveCircle",shortEffect:"−5 em FOR, DES e CON",description:"O personagem sofre −5 em testes de Força, Destreza e Constituição e de perícias baseadas nesses atributos. Se o personagem ficar debilitado novamente, em vez disso fica inconsciente.",mechanical:!0,affectedAttributes:[Atributo.FORCA,Atributo.DESTREZA,Atributo.CONSTITUICAO],generateBonuses:()=>skillsByAttrsPenalty(-5,[Atributo.FORCA,Atributo.DESTREZA,Atributo.CONSTITUICAO]),generateThreatEffects:()=>threatSkillsByAttrsPenalty(-5,[Atributo.FORCA,Atributo.DESTREZA,Atributo.CONSTITUICAO])},desprevenido:{id:"desprevenido",name:"Desprevenido",category:"geral",icon:"Shield",shortEffect:"−5 na Defesa e em Reflexos",description:"O personagem sofre −5 na Defesa e em Reflexos. Você fica desprevenido contra inimigos que não possa perceber.",mechanical:!0,generateBonuses:()=>[{target:{type:"Defense"},modifier:{type:"Fixed",value:-5}},{target:{type:"Skill",name:"Reflexos"},modifier:{type:"Fixed",value:-5}}],generateThreatEffects:()=>[{type:"defense",value:-5},{type:"skill",value:-5,target:"Reflexos"}]},doente:{id:"doente",name:"Doente",category:"metabolismo",icon:"Sick",shortEffect:"Sob efeito de uma doença",description:"Sob efeito de uma doença. Metabolismo.",mechanical:!1},em_chamas:{id:"em_chamas",name:"Em Chamas",category:"geral",icon:"LocalFireDepartment",shortEffect:"1d6 dano de fogo por turno",description:"O personagem está pegando fogo. No início de seus turnos, sofre 1d6 pontos de dano de fogo. O personagem pode gastar uma ação padrão para apagar o fogo com as mãos. Imersão em água também apaga as chamas.",mechanical:!1},enfeiticado:{id:"enfeiticado",name:"Enfeitiçado",category:"mental",icon:"AutoAwesome",shortEffect:"+10 Diplomacia da fonte; percepção favorável",description:"O personagem se torna prestativo em relação à fonte da condição. Ele não fica sob controle da fonte, mas percebe suas palavras e ações da maneira mais favorável possível. A fonte da condição recebe +10 em testes de Diplomacia com o personagem. Mental.",mechanical:!1},enjoado:{id:"enjoado",name:"Enjoado",category:"metabolismo",icon:"MoodBad",shortEffect:"Só 1 ação por rodada",description:"O personagem só pode realizar uma ação padrão ou de movimento (não ambas) por rodada. Ele pode gastar uma ação padrão para fazer uma investida, mas pode avançar no máximo seu deslocamento (e não o dobro). Metabolismo.",mechanical:!1},enredado:{id:"enredado",name:"Enredado",category:"movimento",icon:"Link",shortEffect:"Lento, vulnerável, −2 em ataques",description:"O personagem fica lento, vulnerável e sofre −2 em testes de ataque. Movimento.",mechanical:!0,implies:["lento","vulneravel"],generateBonuses:()=>[{target:{type:"AllAttackBonus"},modifier:{type:"Fixed",value:-2}}],generateThreatEffects:()=>[{type:"attackBonus",value:-2}]},envenenado:{id:"envenenado",name:"Envenenado",category:"veneno",icon:"Science",shortEffect:"Efeito varia por veneno",description:"O efeito desta condição varia de acordo com o veneno. Pode ser perda de vida recorrente ou outra condição (como fraco ou enjoado). Perda de vida recorrente por venenos é cumulativa. Veneno.",mechanical:!1},esmorecido:{id:"esmorecido",name:"Esmorecido",category:"mental",icon:"SentimentVeryDissatisfied",shortEffect:"−5 em INT, SAB e CAR",description:"O personagem sofre −5 em testes de Inteligência, Sabedoria e Carisma e de perícias baseadas nesses atributos. Mental.",mechanical:!0,affectedAttributes:[Atributo.INTELIGENCIA,Atributo.SABEDORIA,Atributo.CARISMA],generateBonuses:()=>skillsByAttrsPenalty(-5,[Atributo.INTELIGENCIA,Atributo.SABEDORIA,Atributo.CARISMA]),generateThreatEffects:()=>threatSkillsByAttrsPenalty(-5,[Atributo.INTELIGENCIA,Atributo.SABEDORIA,Atributo.CARISMA])},exausto:{id:"exausto",name:"Exausto",category:"cansaco",icon:"BatteryAlert",shortEffect:"Debilitado, lento e vulnerável",description:"O personagem fica debilitado, lento e vulnerável. Se ficar exausto novamente, em vez disso fica inconsciente. Cansaço.",mechanical:!0,implies:["debilitado","lento","vulneravel"]},fascinado:{id:"fascinado",name:"Fascinado",category:"mental",icon:"RemoveRedEye",shortEffect:"Atenção presa; −5 Percepção; não age",description:"Com a atenção presa em alguma coisa. O personagem sofre −5 em Percepção e não pode fazer ações, exceto observar aquilo que o fascinou. Esta condição é anulada por ações hostis contra o personagem ou se o que o fascinou não estiver mais visível. Balançar uma criatura fascinada para tirá-la desse estado gasta uma ação padrão. Mental.",mechanical:!1},fatigado:{id:"fatigado",name:"Fatigado",category:"cansaco",icon:"BatteryLow",shortEffect:"Fraco e vulnerável",description:"O personagem fica fraco e vulnerável. Se ficar fatigado novamente, em vez disso fica exausto. Cansaço.",mechanical:!0,implies:["fraco","vulneravel"]},fraco:{id:"fraco",name:"Fraco",category:"geral",icon:"TrendingDown",shortEffect:"−2 em FOR, DES e CON",description:"O personagem sofre −2 em testes de Força, Destreza e Constituição e de perícias baseadas nesses atributos. Se ficar fraco novamente, em vez disso fica debilitado.",mechanical:!0,affectedAttributes:[Atributo.FORCA,Atributo.DESTREZA,Atributo.CONSTITUICAO],generateBonuses:()=>skillsByAttrsPenalty(-2,[Atributo.FORCA,Atributo.DESTREZA,Atributo.CONSTITUICAO]),generateThreatEffects:()=>threatSkillsByAttrsPenalty(-2,[Atributo.FORCA,Atributo.DESTREZA,Atributo.CONSTITUICAO])},frustrado:{id:"frustrado",name:"Frustrado",category:"mental",icon:"MoodBad",shortEffect:"−2 em INT, SAB e CAR",description:"O personagem sofre −2 em testes de Inteligência, Sabedoria e Carisma e de perícias baseadas nesses atributos. Se ficar frustrado novamente, em vez disso fica esmorecido. Mental.",mechanical:!0,affectedAttributes:[Atributo.INTELIGENCIA,Atributo.SABEDORIA,Atributo.CARISMA],generateBonuses:()=>skillsByAttrsPenalty(-2,[Atributo.INTELIGENCIA,Atributo.SABEDORIA,Atributo.CARISMA]),generateThreatEffects:()=>threatSkillsByAttrsPenalty(-2,[Atributo.INTELIGENCIA,Atributo.SABEDORIA,Atributo.CARISMA])},imovel:{id:"imovel",name:"Imóvel",category:"movimento",icon:"DoNotStep",shortEffect:"Deslocamento 0m",description:"Todas as f