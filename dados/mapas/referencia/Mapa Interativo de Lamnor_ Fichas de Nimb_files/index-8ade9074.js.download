od:1},{attr:Atributo.CARISMA,mod:-1}]},faithProbability:{ARSENAL:1,MEGALOKK:1,TENEBRA:1},abilities:[{name:"Arte da Guerra",description:"Você é treinado em Guerra e recebe proficiência em armas marciais. Se receber essa proficiência novamente, recebe +2 em rolagens de dano com essas armas.",sheetActions:[{source:{type:"power",name:"Arte da Guerra"},action:{type:"learnSkill",availableSkills:[Skill$3.GUERRA],pick:1}},{source:{type:"power",name:"Arte da Guerra"},action:{type:"addProficiency",availableProficiencies:["Armas Marciais"],pick:1}}]},{name:"Metalurgia Hobgoblin",description:METALURGIA_HOBGOBLIN_DESCRIPTION,sheetBonuses:[{source:{type:"power",name:"Metalurgia Hobgoblin"},target:{type:"Skill",name:Skill$3.OFICIO_ARMEIRO},modifier:{type:"Fixed",value:2}}]},{name:"Táticas de Guerrilha",description:"Você recebe visão no escuro e +2 em Furtividade.",sheetBonuses:[{source:{type:"power",name:"Táticas de Guerrilha"},target:{type:"Skill",name:Skill$3.FURTIVIDADE},modifier:{type:"Fixed",value:2}}]}]};function complicationSource(_e){return{type:"complication",complicationName:_e}}function skillPenalty(_e,et){return et.map(tt=>({target:{type:"Skill",name:tt},modifier:{type:"Fixed",value:_e}}))}function skillsByAttrPenalty(_e,et){return Object.entries(SkillsAttrs).filter(([,tt])=>et.includes(tt)).map(([tt])=>({target:{type:"Skill",name:tt},modifier:{type:"Fixed",value:_e}}))}const RESISTANCE_SKILLS=[Skill$3.FORTITUDE,Skill$3.REFLEXOS,Skill$3.VONTADE];function withSource$1(_e,et){return et.map(tt=>({...tt,source:complicationSource(_e)}))}const GENERAL_COMPLICATIONS=[{name:"Amaldiçoado",type:"geral",description:"Você foi amaldiçoado por uma entidade poderosa (um lich, um nobre feérico, um Lorde da Tormenta ou mesmo um deus). No início de cada cena envolvendo qualquer tipo de risco ou perigo, role 1d6. Em um resultado 1, você não consegue usar seus pontos de mana nessa cena."},{name:"Apetitoso",type:"geral",description:"Por algum motivo, feras salivam ao farejá-lo. Animais e monstros recebem +5 em testes de ataque e rolagens de dano contra você."},{name:"Assombrado",type:"geral",description:"Você é assombrado por um ser desagradável (o fantasma de um ancestral, uma fada travessa ou um diabrete zombeteiro). Ele conta no seu limite de parceiros, mas não fornece nenhum benefício. Além disso, no início de cada cena envolvendo qualquer tipo de risco ou perigo, role um dado. Em um resultado ímpar, você fica alquebrado até o fim da cena."},{name:"Cabeça Quente",type:"geral",description:"Sempre que você sofre dano, seu próximo turno deve ser dedicado a atacar a fonte do dano. Se não puder atacá-la, deve gastar sua próxima ação de movimento esbravejando contra o ar."},{name:"Caolho",type:"geral",description:"Você não tem um dos olhos. Você sofre –2 em Iniciativa, Percepção, Pontaria e Reflexos e fica automaticamente flanqueado por dois ou mais oponentes em corpo a corpo.",sheetBonuses:withSource$1("Caolho",skillPenalty(-2,[Skill$3.INICIATIVA,Skill$3.PERCEPCAO,Skill$3.PONTARIA,Skill$3.REFLEXOS]))},{name:"Chato",type:"geral",description:"Sempre que você sai de uma aldeia, uma festa acontece. Você sofre –5 em Diplomacia e a atitude inicial de NPCs em relação a você é uma categoria pior.",sheetBonuses:withSource$1("Chato",skillPenalty(-5,[Skill$3.DIPLOMACIA]))},{name:"Combalido",type:"geral",description:"Por alguma razão, natural ou sobrenatural, sua saúde é frágil. Você sofre –5 em Fortitude e recebe –1 PV por nível de personagem.",sheetBonuses:[...withSource$1("Combalido",skillPenalty(-5,[Skill$3.FORTITUDE])),{source:complicationSource("Combalido"),target:{type:"PV"},modifier:{type:"LevelCalc",formula:"-{level}"}}]},{name:"Covarde",type:"geral",description:"Seu lema é “aquele que foge hoje vive para lutar amanhã”. Você sofre –5 em testes de resistência contra efeitos de medo e, no início de cada cena envolvendo qualquer tipo de risco ou perigo, deve rolar um dado. Em um resultado ímpar, você fica abalado (mesmo que seja imune a isso)."},{name:"Cria de Nimb",type:"geral",description:"Você tem um parafuso a menos. Você sofre –5 em testes de perícias baseadas em Carisma. Além disso, no início de cada cena de ação, role 1d6. Com um resultado 1, você fica confuso (mesmo que seja imune a essa condição). Você não pode escolher esta complicação se for devoto de Nimb ou se, por algum outro motivo, seguir suas Obrigações & Restrições.",sheetBonuses:withSource$1("Cria de Nimb",skillsByAttrPenalty(-5,[Atributo.CARISMA]))},{name:"Criado na Cidade",type:"geral",description:"Você não se dá bem no mato. Você sofre –5 em Sobrevivência e, quando descansa nos ermos, sua recuperação é uma categoria pior (se já era ruim, recupera apenas 1 PV e 1 PM, independentemente do seu nível).",sheetBonuses:withSource$1("Criado na Cidade",skillPenalty(-5,[Skill$3.SOBREVIVENCIA]))},{name:"Crise de Fé",type:"geral",behavioral:!0,description:"Você segue um dos deuses do Panteão, mas no fundo se pergunta se isso é o certo. Você sofre –2 em Vontade e segue as Obrigações & Restrições de um deus, mas não recebe nenhum poder concedido nem conta como devoto dessa divindade para cumprir pré-requisitos. Você não pode ser devoto de outro deus.",sheetBonuses:withSource$1("Crise de Fé",skillPenalty(-2,[Skill$3.VONTADE]))},{name:"Desprotegido",type:"geral",description:"Você nunca aprendeu a se defender. Você sofre –2 na Defesa e em testes de resistência.",sheetBonuses:[{source:complicationSource("Desprotegido"),target:{type:"Defense"},modifier:{type:"Fixed",value:-2}},...withSource$1("Desprotegido",skillPenalty(-2,RESISTANCE_SKILLS))]},{name:"Distraído",type:"geral",description:"Você é muito desligado e... Hein? Do que estávamos falando? Você sofre –5 em Iniciativa e Percepção.",sheetBonuses:withSource$1("Distraído",skillPenalty(-5,[Skill$3.INICIATIVA,Skill$3.PERCEPCAO]))},{name:"Emotivo",type:"geral",description:"Fadado a sofrer, você não se beneficia de efeitos que forneçam bônus numéricos (em atributos, testes, Defesa etc.) usados por outros personagens."},{name:"Expurgo de Wynna",type:"geral",description:"Algo em você não agrada à Deusa da Magia. Você sofre –5 em testes de resistência contra efeitos mágicos."},{name:"Fracote",type:"geral",description:"Você cresceu dentro dos muros de um palácio ou enfurnado na torre de um mago e nunca praticou atividades físicas. Você está permanentemente fraco (mesmo que seja imune a essa condição)."},{name:"Hedonista",type:"geral",description:"Você está acostumado a viver no luxo e não aceita nada abaixo disso. Em condições luxuosas, sua recuperação de PV e PM é igual ao seu nível. Em condições confortáveis, é igual à metade do seu nível. Em condições normais ou ruins, recupera apenas 1 PV e 1 PM, independentemente do nível."},{name:"Ímpio",type:"geral",description:"Você odeia os deuses — e eles sabem disso. Você sofre –5 em testes de resistência contra magias divinas e não pode se beneficiar de efeitos dessas magias."},{name:"Impulsivo",type:"geral",description:"Você age primeiro e pensa depois (ou nunca). Você sofre –5 em Furtividade e Investigação, e não pode fazer as ações atrasar e preparar.",sheetBonuses:withSource$1("Impulsivo",skillPenalty(-5,[Skill$3.FURTIVIDADE,Skill$3.INVESTIGACAO]))},{name:"Inculto",type:"geral",description:"Você não teve acesso à educação. Você é analfabeto e recebe duas perícias treinadas a menos (isso pode reduzir a zero as perícias que pode escolher, mas não afeta as perícias fixas de sua classe)."},{name:"Indolente",type:"geral",description:"Você é apático e preguiçoso. Você sofre –5 em Reflexos e –3m em seu deslocamento.",sheetBonuses:[...withSource$1("Indolente",skillPenalty(-5,[Skill$3.REFLEXOS])),{source:complicationSource("Indolente"),target:{type:"Displacement"},modifier:{type:"Fixed",value:-3}}]},{name:"Ingênuo",type:"geral",description:"Não há maldade em seu coração. Você sofre –5 em Enganação, Intuição, Investigação e Ladinagem.",sheetBonuses:withSource$1("Ingênuo",skillPenalty(-5,[Skill$3.ENGANACAO,Skill$3.INTUICAO,Skill$3.INVESTIGACAO,Skill$3.LADINAGEM]))},{name:"Maneta",type:"geral",description:"Você não tem uma das mãos. Você só pode empunhar um item (e, obviamente, não pode usar armas de duas mãos)."},{name:"Marcado pelo Passado",type:"geral",description:"Um evento em seu passado o deixou taciturno e sombrio. Você sofre –5 em Diplomacia e recebe –1 PM por nível de personagem.",sheetBonuses:[...withSource$1("Marcado pelo Passado",skillPenalty(-5,[Skill$3.DIPLOMACIA])),{source:complicationSource("Marcado pelo Passado"),target:{type:"PM"},modifier:{type:"LevelCalc",formula:"-{level}"}}]},{name:"Matugo",type:"geral",description:"Você não se dá bem em cidades. Você fica alquebrado em ambientes urbanos e, quando descansa nesses ambientes, sua recuperação é uma categoria pior (se já era ruim, recupera apenas 1 PV e 1 PM, independentemente do nível)."},{name:"Míope",type:"geral",description:"Você tem dificuldade de enxergar objetos distantes. Você sofre –5 em Percepção e Pontaria, e fica desprevenido contra efeitos que se originem além de alcance curto.",sheetBonuses:withSource$1("Míope",skillPenalty(-5,[Skill$3.PERCEPCAO,Skill$3.PONTARIA]))},{name:"Mouco",type:"geral",description:"Sua audição é ruim. Você sofre –2 em Iniciativa, Intuição, Percepção e Reflexos.",sheetBonuses:withSource$1("Mouco",skillPenalty(-2,[Skill$3.INICIATIVA,Skill$3.INTUICAO,Skill$3.PERCEPCAO,Skill$3.REFLEXOS]))},{name:"Paladar Infantil",type:"geral",description:"Você é chato para comer. Não se beneficia de itens da categoria alimentação, nem de poções. Além disso, sofre –2 em testes de perícias baseadas em Carisma durante situações sociais baseadas em refeições."},{name:"Paranoico",type:"geral",description:"Você não confia em ninguém, nem em seus aliados. Você precisa passar em um teste de Vontade (CD 20 + seu nível) para aceitar qualquer ajuda — até mesmo cura! Se falhar, recusa a ajuda e, se for ajudado mesmo assim, fica alquebrado até o fim da cena. Além disso, sua condição de descanso é sempre uma categoria pior do que seria pelas circunstâncias."},{name:"Temeroso",type:"geral",description:"Você tem medo de se machucar. Você sofre –5 em Luta e, enquanto estiver adjacente a um inimigo, fica abalado.",sheetBonuses:withSource$1("Temeroso",skillPenalty(-5,[Skill$3.LUTA]))},{name:"Tolo",type:"geral",description:"É fácil enganá-lo e manipulá-lo. Você sofre –5 em Intuição e Vontade.",sheetBonuses:withSource$1("Tolo",skillPenalty(-5,[Skill$3.INTUICAO,Skill$3.VONTADE]))},{name:"Vagaroso",type:"geral",description:"“Devagar e sempre vence a corrida.” Você está permanentemente sob efeito da condição lento (todas as suas formas de deslocamento são reduzidas à metade e você não pode correr ou fazer investidas)."}],CLASS_COMPLICATIONS=[{name:"Arcanista de Rotina",type:"classe",className:"Arcanista",description:"Você não está acostumado a lançar magias sob pressão. Se estiver em alcance curto de qualquer ameaça, é considerado sob condição ruim para lançar magias. Se já estiver sob condição ruim ou terrível para conjurar, a CD do teste aumenta em +2."},{name:"Foco Exigente",type:"classe",className:"Arcanista",prerequisite:"Bruxo",description:"Seu foco o pune quando você falha. Sempre que uma criatura passa em um teste de resistência contra uma magia sua, você perde 1 PV por PM gasto na magia. Pré-requisito: Bruxo."},{name:"Linhagem Prepotente",type:"classe",className:"Arcanista",prerequisite:"Feiticeiro",description:"Sua magia inata rejeita auxílio de cacarecos. Você não pode usar catalisadores e itens esotéricos mundanos. Ainda pode usar itens esotéricos mágicos. Pré-requisito: Feiticeiro."},{name:"Mente Cansada",type:"classe",className:"Arcanista",prerequisite:"Mago",description:"Quanto mais magias você aprende, mais difícil fica lembrar de todas! Para cada círculo de magia que você pode lançar, o total de magias que pode memorizar diminui em 1. Pré-requisito: Mago."},{name:"De Peito Aberto",type:"classe",className:"Bárbaro",behavioral:!0,description:"Você quer exibir suas tatuagens tribais, confia na sua resistência natural ou só acha seu corpo lindo. Você não pode vestir armaduras e seu limite de itens vestidos diminui em dois."},{name:"Totem Gigante",type:"classe",className:"Bárbaro",behavioral:!0,description:"Você carrega uma grande coluna de madeira esculpida que jamais pode abandonar. A coluna ocupa 10 espaços e impõe penalidade de armadura –5."},{name:"Estrelismo",type:"classe",className:"Bardo",description:"Você é lindo, talentoso e… extremamente egocêntrico. Você sofre –5 em testes de Diplomacia e Intuição. Além disso, sempre que falha em um teste de Atuação, fica alquebrado até o fim da cena.",sheetBonuses:withSource$1("Estrelismo",skillPenalty(-5,[Skill$3.DIPLOMACIA,Skill$3.INTUICAO]))},{name:"Falastrão",type:"classe",className:"Bardo",description:"Você está sempre dando suas palestrinhas, não consegue ficar quieto e deve ser sempre o primeiro a falar. Você sofre –5 em testes de Furtividade e Nobreza.",sheetBonuses:withSource$1("Falastrão",skillPenalty(-5,[Skill$3.FURTIVIDADE,Skill$3.NOBREZA]))},{name:"Coragem Líquida",type:"classe",className:"Bucaneiro",description:"No início do seu turno, em cenas envolvendo qualquer risco ou perigo, role 1d4. Em um resultado 1, você precisa gastar uma ação de movimento para tomar um gole de bebida. Se não puder, fica pasmo pela rodada (mesmo se for imune a isso)."},{name:"Esbanjador",type:"classe",className:"Bucaneiro",description:"Você tem certas necessidades que alguns chamam de “luxo”. Para subir de nível, além de acumular XP suficiente, você deve “torrar” tibares em festas e frivolidades, em valor igual a 20% da diferença do dinheiro inicial do nível que vai alcançar para o nível atual."},{name:"Limitado a (Criatura)",type:"classe",className:"Caçador",description:"Você se especializou em lutar contra um inimigo específico — e só. Escolha um tipo de criatura do poder Inimigo de (Criatura). O custo base para usar Marca da Presa contra criaturas de outros tipos muda para 3 PM."},{name:"Superprotetor",type:"classe",className:"Cavaleiro",description:"Você faz questão de ficar perto de seus companheiros. Durante qualquer cena envolvendo qualquer tipo de risco ou perigo, você sempre deve terminar seu turno adjacente a um aliado. Se não fizer isso, fica alquebrado e sofre –2 em seus testes por 1 rodada."},{name:"Divindade Exigente",type:"classe",className:"Clérigo",description:"Você serve a sua divindade com afinco, mas às vezes ela quer sua atenção exclusiva. Sempre que lançar uma magia divina, role 1d6. Em um resultado 1, você fica frustrado (essa condição é cumulativa)."},{name:"Preparação Litúrgica",type:"classe",className:"Clérigo",description:"Você só pode lançar magias preparadas. Para preparar, gaste uma hora do dia em ritual litúrgico e escolha metade das magias que conhece; só pode lançar as escolhidas. Caso não possa se preparar, não pode trocar as magias escolhidas no dia anterior."},{name:"Tosco",type:"classe",className:"Druida",behavioral:!0,description:"Você não se dá bem com objetos civilizados. Você não pode usar itens superiores."},{name:"Precavido",type:"classe",className:"Guerreiro",description:"Enquanto não conhece as capacidades do inimigo, você luta de maneira cautelosa: –2 em testes de ataque e resistência. A partir da segunda rodada de combate, pode se livrar dessa penalidade até o fim da cena gastando uma ação de movimento e passando em um teste de Guerra (CD 15 + ND do inimigo mais poderoso na cena)."},{name:"Trabalhador Ocupado",type:"classe",className:"Inventor",description:"Você está tão ocupado trabalhando para os outros que não tem tempo de fazer seus próprios projetos! Você não recebe a habilidade Protótipo e, quando recebe a habilidade Fabricar Item Superior, não recebe um item gratuito."},{name:"Honra de Ladrão",type:"classe",className:"Ladino",behavioral:!0,description:"Você pode ser um bandido e salafrário, mas tem seus princípios. Você sempre cumpre suas promessas e nunca rouba ou tira vantagem de pessoas com menos recursos que você e seu grupo. O mestre tem a palavra final sobre o que é “tirar vantagem” de alguém."},{name:"Firula",type:"classe",className:"Lutador",behavioral:!0,description:"Na primeira rodada de cada combate, você deve gastar uma ação padrão apresentando-se, fazendo uma coreografia ou informando seu peso, altura e cartel."},{name:"Filantropo",type:"classe",className:"Nobre",description:"Você doa parte de sua riqueza para fazer o bem. Você não recebe a habilidade Espólio e, quando usa sua habilidade Riqueza, recebe apenas metade do valor normal."},{name:"Mimado",type:"classe",className:"Nobre",description:"Bajulado desde criança, você fica desconcertado sempre que percebe que não é tão bom quanto lhe diziam. Na primeira vez em cada cena que falha em um teste de perícia, você perde 1 PM por patamar. Se já estiver sem PM, fica frustrado por 1 rodada."},{name:"Certinho",type:"classe",className:"Paladino",description:"Você faz tudo do jeito correto e fica desconfortável quando um companheiro não age assim. Sempre que um aliado fizer algo que violaria seu Código do Herói, isso conta como uma violação sua — a menos que você não note, o que exige dele um teste de Enganação ou Furtividade contra sua Percepção ou Intuição (o que for maior)."}],COMPLICATIONS=[...GENERAL_COMPLICATIONS,...CLASS_COMPLICATIONS];function getComplications(_e){const et=COMPLICATIONS.filter(at=>at.type==="geral"),tt=COMPLICATIONS.filter(at=>at.type==="classe"&&at.className!==void 0&&_e!==void 0&&isClassOrVariantOf(_e,at.className));return{general:et,classSpecific:tt}}function getComplicationByName(_e){return COMPLICATIONS.find(et=>et.name===_e)}function scaledMinAge(_e,et){const{multiplier:tt,fromAdultOnly:at}=getRaceAgeScaling(et),rt=!at||_e.id!=="jovem";return Math.round(_e.minAge*(rt?tt:1))}function getBaseAgeStages(_e){const et=BASE_AGE_STAGES.map(tt=>scaledMinAge(tt,_e));return BASE_AGE_STAGES.map((tt,at)=>({...tt,minAge:et[at],maxAge:at===BASE_AGE_STAGES.length-1?void 0:et[at+1]-1}))}function getBaseAgeStageRange(_e,et){return getBaseAgeStages(et).find(tt=>tt.id===_e)}function getBaseAgeStageForYears(_e,et){if(_e===void 0||Number.isNaN(_e))return"jovem";const at=[...getBaseAgeStages(et)].reverse().find(rt=>_e>=rt.minAge);return(at==null?void 0:at.id)??"jovem"}function getBaseAgeStage(_e){if(_e)return BASE_AGE_STAGES.find(et=>et.id===_e)}function getBaseAgeAttributeModifiers(_e){var et;return((et=getBaseAgeStage(_e))==null?void 0:et.attributeModifiers)??[]}function getInitialAgeGroup(_e){const et=_e?INITIAL_AGE_GROUP_BY_CLASS[_e.name]:void 0,tt=_e!=null&&_e.baseClassName?INITIAL_AGE_GROUP_BY_CLASS[_e.baseClassName]:void 0;return INITIAL_AGE_GROUPS[et??tt??DEFAULT_INITIAL_AGE_GROUP]}function rollInitialAge(_e){const et=getInitialAgeGroup(_e);return rollDice$1(et.qtdDados,et.numFaces)+et.bonus}function getAgeAttributeTotals(_e){return _e?_e.bracket?getAgeAttributeModifiers(_e.bracket):getBaseAgeAttributeModifiers(_e.stage):[]}function getAgeAttributeTotalsDelta(_e,et){const tt=new Map;return getAgeAttributeTotals(_e).forEach(({attribute:at,value:rt})=>{tt.set(at,(tt.get(at)??0)-rt)}),getAgeAttributeTotals(et).forEach(({attribute:at,value:rt})=>{tt.set(at,(tt.get(at)??0)+rt)}),[...tt.entries()].filter(([,at])=>at!==0).map(([at,rt])=>({attribute:at,value:rt}))}function getStageEntryAge(_e,et,tt){const at=getBaseAgeStageRange(_e,et);if(at&&at.minAge>0)return at.minAge;const rt=getInitialAgeGroup(tt);return rt.qtdDados+rt.bonus}function getAgeAttributeTotalsForSelection(_e,et){return _e?getAgeAttributeTotals({years:_e.years,stage:getBaseAgeStageForYears(_e.years,et),bracket:_e.variedAges?_e.bracket:void 0,complications:[],extraLevels:0}):[]}const APARATO_ACTIVATION_DC_ONE=2,APARATO_ACTIVATION_DC_TWO=5,MAX_APARATOS_PER_ENGENHOCA=2,APARATOS=[{id:"captador-de-luz",nome:"Captador de luz",preco:450,descricao:"Um conjunto de lentes e cristais adaptado à engenhoca, capaz de não apenas captar a luz mundana do ambiente, mas também a energia positiva presente nela. Toda cura de luz fornecida pela engenhoca aumenta em +1 por dado. Funciona apenas com engenhocas com efeitos de cura de luz.",restriction:"Funciona apenas com engenhocas com efeitos de cura de luz."},{id:"comutador",nome:"Comutador",preco:300,descricao:"Uma bobina de metal místico, capaz de captar e potencializar a energia do ambiente. Diminui o custo total dos aprimoramentos da engenhoca em –1 PM.",aprimoramentoPmDelta:-1},{id:"conversor-alimentador",nome:"Conversor-alimentador",preco:300,descricao:"Este frasco de vidro é ligado a tubos de metal e estranhos mecanismos em forma de antena. Comporta três doses de essência de mana (ou outros preparados alquímicos que forneçam PM). Quando ativa a engenhoca, você pode gastar um preparado alquímico que forneça PM e usar os PM fornecidos para pagar seu custo de aprimoramentos e para sustentá-la (caso se aplique)."},{id:"engenho-de-automacao",nome:"Engenho de automação",preco:600,descricao:"Este aparato envolve dezenas de engrenagens e pistões que funcionam sob a instrução de cartões perfurados, agindo por si só segundo um padrão programado. Acoplado a uma engenhoca que simula uma magia com duração sustentada, permite que ela não conte no limite de magias que você pode sustentar simultaneamente. Você só pode ter uma engenhoca sustentada adicional dessa forma por vez. Pré-requisito: conversor-alimentador.",requires:"conversor-alimentador",restriction:"Só tem efeito em engenhocas com duração sustentada."},{id:"espera-para-melhorias",nome:"Espera para melhorias",preco:150,descricao:"Este aparato funciona como um adaptador que permite instalar melhorias de outros itens na engenhoca. Fazer isso segue as mesmas regras e custos para aplicar melhorias em itens convencionais. De forma geral, se uma melhoria afeta uma característica da magia simulada pela engenhoca, ela pode ser aplicada (uma engenhoca que simula Armadura Arcana poderia receber melhorias de armaduras, por exemplo). Para materiais especiais, o custo da melhoria é baseado no tipo de efeito que ela vai gerar (arma, armadura ou esotérico — se mais de um for aplicável, você deve escolher apenas uma). Uma engenhoca pode receber mais de uma espera, e cada uma permite instalar uma melhoria (mas efeitos iguais não se acumulam, como normal). A critério do mestre, melhorias que não se apliquem naturalmente a engenhocas ainda podem ser aplicadas."},{id:"estabilizador",nome:"Estabilizador",preco:900,descricao:"Uma gaiola de arame fino que envolve uma engenhoca. Aumenta a CD para resistir ao efeito da engenhoca em +2.",resistDcBonus:2},{id:"estimulador-de-sobrecarga",nome:"Estimulador de sobrecarga",preco:750,descricao:"Um mecanismo de aparência agressiva, com engrenagens barulhentas que giram de forma independente. Aumenta o dano provocado pela engenhoca em +1 dado. Funciona apenas em engenhocas que causam dano.",restriction:"Funciona apenas em engenhocas que causam dano."},{id:"gatilho-de-corda",nome:"Gatilho de corda",preco:1500,descricao:"Um mecanismo simples, com algumas engrenagens e uma chave. Este aparato só pode ser instalado em engenhocas que simulem magias com execução de ação padrão, e permite que você ative a engenhoca com uma ação de movimento. Contudo, uma vez que a engenhoca seja ativada, você só poderá ativá-la novamente após dar corda no gatilho, o que exige uma ação completa.",restriction:"Só pode ser instalado em engenhocas que simulem magias com execução de ação padrão."},{id:"giroscopio",nome:"Giroscópio",preco:450,descricao:"Este sistema de contrapesos, amortecedores e roldanas é instalado ao redor da engenhoca, deixando-a sempre estável. Você não aplica sua penalidade de armadura por armadura nos testes de ativação da engenhoca (mas aplica penalidades de armadura de outras fontes).",ignoresArmorPenalty:!0},{id:"ligacao-de-convergencia",nome:"Ligação de convergência",preco:300,descricao:"Este aparato deve ser acoplado a duas engenhocas (nem mais, nem menos), transformando ambas em uma. As duas engenhocas contam como uma só para efeitos do limite de engenhocas que você pode manter ao mesmo tempo. Contudo, uma vez que uma delas seja ativada, a outra não pode ser ativada na mesma cena. Nas cenas seguintes, é possível ativar a outra engenhoca, mas se o efeito da anterior ainda estiver ativo (como por durar 1 dia), ele é dissipado.",restriction:"Deve ser acoplado a exatamente duas engenhocas."},{id:"remontagem-de-portabilidade",nome:"Remontagem de portabilidade",preco:300,descricao:'Este aparato é na verdade uma modificação total da engenhoca: uma série de molas, hastes e fios que permite que a engenhoca seja "desmontada" e unida a um item de vestuário. A engenhoca não ocupa nenhum espaço e, enquanto o item estiver vestido, conta como se também estivesse vestida (sem contar no limite de itens vestidos). Contudo, ela modifica drasticamente o item de vestuário. Qualquer um que o veja pode notar que há uma engenhoca mesclada ao item. Você só pode ter uma engenhoca vestida desta forma por vez.'},{id:"sequenciador-de-ativacao",nome:"Sequenciador de ativação",preco:600,descricao:"Este mecanismo complexo, cheio de partes móveis, alavancas e engrenagens, é acoplado simultaneamente a três engenhocas. Uma vez por cena, você pode gastar uma ação completa para ativar o sequenciador. No início de cada um dos seus próximos turnos, uma das engenhocas acopladas ao sequenciador é ativada como uma ação livre, em uma ordem definida ao acoplá-las ao aparato. Não é possível diminuir a ação necessária para ativar o sequenciador. Você faz os testes de Ofício (engenhoqueiro) normalmente para cada engenhoca. Se algum dos testes falhar, além de essa engenhoca não ser ativada, a sequência de ativação termina (as próximas não serão mais ativadas como ação livre).",restriction:"É acoplado simultaneamente a três engenhocas."},{id:"sistema-de-refrigeracao",nome:"Sistema de refrigeração",preco:900,descricao:"Um conjunto de ventoinhas que fazem ar fresco circular entre os componentes da engenhoca e tubos cheios d'água, que dissipam calor por sua correnteza interna. Uma vez por dia, você pode gastar uma ação completa e 1 PM para acionar as ventoinhas e resfriar a engenhoca. Fazer isso reduz a CD de ativação da engenhoca em –5.",activationDcToggle:{label:"Sistema de refrigeração acionado (1x/dia, 1 PM)",value:-5}},{id:"supressor-de-seguranca",nome:"Supressor de segurança",preco:300,descricao:"Este sistema de mecanismos de contingência é instalado dentro da engenhoca e interrompe a operação do item em caso de mau funcionamento. Uma vez por cena, a engenhoca não enguiça com uma falha no teste de ativação (ela não ativa seu efeito, mas a CD para o próximo teste não aumenta e ela continua funcionando sem precisar ser consertada)."},{id:"transformador-mistico",nome:"Transformador místico",preco:600,descricao:"Um conjunto de cristais ligados a mecanismos complexos, capaz de captar a energia mágica inerente a certos objetos e convertê-la para que possa ser usada em engenhocas. Permite acoplar um item esotérico à engenhoca, que fornece seus benefícios à magia simulada por ela (sem necessidade de ser empunhado). Acoplar ou remover o esotérico exige 1 hora de trabalho."}],APARATOS_BY_ID=Object.fromEntries(APARATOS.map(_e=>[_e.id,_e])),HEROIS_ARTON_APARATOS=APARATOS.map(_e=>({nome:_e.nome,descricao:`Aparato (acoplado a uma engenhoca, não ocupa espaço). ${_e.descricao}`,group:"Item Geral",preco:_e.preco,spaces:1}));function sanitizeEngenhoca(_e){if(!_e||typeof _e!="object"||Array.isArray(_e))return;const et=_e,tt={};if(typeof et.nome=="string"&&(tt.nome=et.nome),(et.forma==="empunhada"||et.forma==="vestida")&&(tt.forma=et.forma),Array.isArray(et.aparatos)){const at=Array.from(new Set(et.aparatos.filter(rt=>typeof rt=="string"&&!!APARATOS_BY_ID[rt]))).slice(0,MAX_APARATOS_PER_ENGENHOCA);at.length>0&&(tt.aparatos=at)}return et.enguicada===!0&&(tt.enguicada=!0),tt}const VALID_ATRIBUTOS=Object.values(Atributo);let grantedPowersByNameCache=null;function getGrantedPowersByName(){return grantedPowersByNameCache||(granted